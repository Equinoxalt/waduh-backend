const express = require('express');
const router = express.Router();
const { addMovements, getCurrentStock, getPeriodSummary, lookupBarcode, registerProduct } = require('../controllers/warehouseController');

router.post('/movements', addMovements);
router.get('/stock', getCurrentStock);
router.get('/summary', getPeriodSummary);
router.get('/products/:barcode', lookupBarcode);
router.post('/products', registerProduct);

module.exports = router;